{
  "name": "palavra-30s",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.mjs",
    "build": "tsc -b && vite build",
    "build:worker": "wrangler deploy --dry-run",
    "dev:worker": "wrangler dev --local",
    "deploy:worker": "wrangler deploy",
    "types:worker": "wrangler types worker-configuration.d.ts",
    "preview": "NODE_ENV=production tsx server.mjs",
    "start": "NODE_ENV=production tsx server.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/barlow-condensed": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/syne": "^5.2.7",
    "lucide-react": "^0.539.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.2",
    "@cloudflare/workers-types": "^5.20260813.1",
    "@testing-library/react": "^16.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.122.0"
  }
